<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <sim>
   <minimum-fg-version>2017.2.0</minimum-fg-version>
    <description>Royal Airforce FGR2 Phantom II (YASim)</description>
    <long-description>V1.0 HDR ready</long-description>
    <author>HiTouch(3D instruments) Virtavia (3d Model), StuartC (FDM + assembly), Dave Culp, Avionyx, VooDoo DaVinci</author>
   <description>FGR-2 (YASim)</description>
     <status>Beta</status>
    <flight-model archive="y">yasim</flight-model>
    <aero archive="y">FGR-yasim</aero>

  <fuel-fraction>1.0</fuel-fraction>

      <rating>
			<FDM type="int">3</FDM>
			<systems type="int">2</systems>
			<cockpit type="int">4</cockpit>
			<model type="int">4</model>
		</rating>

		<tags>
			<tag>fighter</tag>
			<tag>RAF</tag>
			<tag>1960s</tag>
			<tag>1970s</tag>
			<tag>1980s</tag>
			<tag>coldwar</tag>
			<tag>supersonic</tag>
			<tag>jet</tag>
			<tag>2-engine</tag>
			<tag>afterburner</tag>
			<tag>McDonald Douglas</tag>
		</tags>

		 <sound>
   <path>Aircraft/FGR-2/Sounds/F4D-sound.xml</path>
  </sound>

    <model>
      <path archive="y">Aircraft/FGR-2/Models/FGR2_Phantom.xml</path>
      <livery>
        <file type="string">DEFAULT XV470</file>
      </livery>
	     <!--  For switching between shiny and non shiny paint in HDR mode -->
			<fgr2>
			<hdr>true</hdr>
				<als>false</als>
				</fgr2>
				<!-- -->
    </model>

	<rendering>
  <refl_correction type="string">-0.43</refl_correction>
	<fresnel-factor>0.4</fresnel-factor>
    <redout>
      <parameters>
        <blackout-onset-g>4.0</blackout-onset-g>
        <blackout-complete-g>8.0</blackout-complete-g>
      </parameters>
    </redout>
  </rendering>

<previews>

  <status>v0.1a</status>
  <aircraft-version>$Id$</aircraft-version>
  
  <flight-model>null</flight-model>

  <presets>
   <onground type="bool">false</onground>
   <altitude-agl-ft type="double">30.0</altitude-agl-ft>
  </presets>

<hud>
   <path n="1">Aircraft/FGR-2/HUD/hud.xml</path>

   <visibility n="1">false</visibility>
   <clipping>
       <left type="double">-60</left>
       <right type="double">60</right>
       <top type="double">33</top>
       <bottom type="double">-56</bottom>
   </clipping>
   <font>
    <size>6</size>
    <name>default.txf</name>
   </font>
  </hud>

  <systems>
      <electrical>
        <path>Aircraft/Generic/generic-electrical.xml</path>
      </electrical>
     
	  <autopilot n="103">
        <path>Aircraft/FGR2/Systems/glass-rain.xml</path>
      </autopilot>
  <refuel>
  <type>boom</type>
  <serviceable type="bool">true</serviceable>
 </refuel>
    
    </systems>

  <!-- 3d model -->
  <model>
   <path>Aircraft/FGR-2/Models/FGR2-WSO.xml</path>
  </model>
  
   <rendering>
  <refl_correction type="string">-0.43</refl_correction>
	<fresnel-factor>0.4</fresnel-factor>
    <redout>
      <parameters>
        <blackout-onset-g>4.0</blackout-onset-g>
        <blackout-complete-g>8.0</blackout-complete-g>
      </parameters> 
    </redout>
  </rendering>

  <!-- Views -->
   
  
   <view n="0">
  <name>Weapons officer View</name>
  <internal archive="y">true</internal>
	
	<type>lookfrom</type>
	<config>
	<from-model type="bool">true</from-model>
	<x-offset-m archive="y">0</x-offset-m>
    <y-offset-m archive="y">1.7</y-offset-m>
    <z-offset-m archive="y">-4.15</z-offset-m>
	<default-field-of-view-deg>140.3</default-field-of-view-deg>
   </config>
  </view>
  
   <view n="100">
	   <name>WSO scope</name>
        <internal archive="y">true</internal>
        <config>
		 <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
       <x-offset-m archive="y">-0.6</x-offset-m>
    <y-offset-m archive="y">1.5</y-offset-m>
    <z-offset-m archive="y">-4.8</z-offset-m>
          <pitch-offset-deg>-3</pitch-offset-deg>
		  <heading-offset-deg>0</heading-offset-deg>
          <default-field-of-view-deg>35</default-field-of-view-deg>
      	<limits>
					<enabled type="bool">true</enabled>
					<left>
						<heading-max-deg type="double">1</heading-max-deg>
						<x-offset-max-m type="double">0.20</x-offset-max-m>
						<x-offset-threshold-deg type="double">1</x-offset-threshold-deg>
					</left>
					<right>
						<heading-max-deg type="double">1</heading-max-deg>
						<x-offset-max-m type="double">0.20</x-offset-max-m>
						<x-offset-threshold-deg type="double">1</x-offset-threshold-deg>
					</right>
					</limits>

	  </config>
	
      </view>
	  
	   <view n="101">
    <name>Pilot cam</name>
        <internal archive="y">false</internal>
        <config>
		 <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
         <x-offset-m archive="y">0</x-offset-m>
    <y-offset-m archive="y">1.42</y-offset-m>
    <z-offset-m archive="y">-5.95</z-offset-m>
          <pitch-offset-deg>0</pitch-offset-deg>
		  <heading-offset-deg>180</heading-offset-deg>
          <default-field-of-view-deg>95</default-field-of-view-deg>
        </config>

  </view>
  
   <view n="102">
  <name>Pilots seat</name>
  <internal archive="y">true</internal>
	<internal archive="y">true</internal>
	<type>lookfrom</type>
	<config>
	<from-model type="bool">true</from-model>
	<x-offset-m archive="y">0</x-offset-m>
    <y-offset-m archive="y">1.62</y-offset-m>
    <z-offset-m archive="y">-4</z-offset-m>
	 <default-field-of-view-deg>100</default-field-of-view-deg>
	<limits>
	   <left>
	  <heading-max-deg>-100</heading-max-deg>
<x-offset-threshold-deg>0</x-offset-threshold-deg>
<x-offset-max-m>0</x-offset-max-m>
</left>
<right>
<heading-max-deg>100</heading-max-deg>
<x-offset-threshold-deg>0</x-offset-threshold-deg>
<x-offset-max-m>0</x-offset-max-m>
</right>
<enabled>1</enabled>
</limits>
   </config>
  </view>
 
 
  <chase-distance-m type="double">-18.0</chase-distance-m>

  <sound>
   <path>Aircraft/FGR-2/Sounds/F4D-sound.xml</path>
  </sound>


		

  <!-- Aircraft specific help. -->
  <!-- help include="help.xml"/ -->

  <!-- systems>
   <electrical>
    <path/>
   </electrical>
  </systems>
  <instrumentation>
   <path/>
  </instrumentation -->

  <menubar>
   <default>
    <menu n="100">
     <label>FGR2</label>
     <item>
      <label>Select Pilot</label>
      <binding>
       <command>nasal</command>
       <script>
        dual_control_tools.
          copilot_dialog.show(aircraft_dual_control.pilot_type);
       </script>
      </binding>
     </item>
    </menu>
   </default>
  </menubar>

 </sim>
 
 
 <input>
   <keyboard>

<key n="72">
      <name>H</name>
      <desc>Active Target Seeking</desc>
      <binding>
        <command>nasal</command>
        <script>hud.activate_borsight()</script>
      </binding>
    </key>
	
	 <key n="82">
      <name>R</name>
      <desc>Active Telemeter</desc>
      <binding>
        <command>nasal</command>
        <!--<script>hud.activate_Telemeter()</script>-->
        <script>
          setprop("instrumentation/radar/az-field",mirage2000.myRadar3.radar_mode_toggle());
        </script>
      </binding>
      <!--      <binding>
      <command>property-toggle</command>
      <property>/ai/closest/range</property>
      <value>-2</value>
      <value>-1</value>
      </binding>-->
    </key>
	
	 <key n="116">
      <name>t</name>
      <desc>Increase Radar Distance</desc>
      <binding>
        <command>nasal</command>
        <script>
          mirage2000.myRadar3.switch_distance_ics();
          setprop("instrumentation/radar/range", mirage2000.myRadar3.get_radar_distance());
          setprop("/instrumentation/radar/range-selected",mirage2000.myRadar3.get_radar_distance());
        </script>
        
        <!--        <script>hud.switch_distance()</script>-->
      </binding>
    </key>
    
    <key n="84">
      <name>T</name>
      <desc>Decrease Radar Distance</desc>
      <binding>
        <command>nasal</command>
        <script>
          mirage2000.myRadar3.switch_distance_dcs();
          setprop("instrumentation/radar/range", mirage2000.myRadar3.get_radar_distance());
          setprop("/instrumentation/radar/range-selected",mirage2000.myRadar3.get_radar_distance());
        </script>
        
        <!--        <script>hud.switch_distance()</script>-->
      </binding>
    </key>
	
	 <key n="113">
      <name>q</name>
      <desc>Toggle radar standby mode</desc>
      <binding>
        <command>property-toggle</command>
        <property>instrumentation/radar/radar-standby</property>
      </binding>
    </key>
	
	
	 <key n="110">
      <name>n</name>
      <desc>Changes Target</desc>
      <binding>
        <command>nasal</command>
        <script>mirage2000.myRadar3.next_Target_Index()</script>
      </binding>
    </key>
    
    <key n="14">
      <name>Ctrl-n</name>
      <desc>Changes Target</desc>
      <binding>
        <command>nasal</command>
        <script>mirage2000.myRadar3.previous_Target_Index()</script>
      </binding>
    </key>
 </keyboard>
 </input>

   
  <instrumentation>
  <marker-beacon>
    <volume type="double" archive="y">0.0</volume>
  </marker-beacon>
<radar>
			<range type="int" archive="y">20</range>
			<range-factor type="double" archive="n">0.001888</range-factor>
			<minimized type="bool" archive="y">false</minimized>
			<selected type="int">3</selected>
			<enabled type="bool">true</enabled>
			<az-field type="double">120</az-field>
			<range type="double">150</range>
			<range-selected type="double">50</range-selected>
			<radar2-range type="double">150</radar2-range>
			<display-rdr type="bool">true</display-rdr>
			<radar-standby type="int">3</radar-standby>
			<mode>
				<rws type="bool">true</rws>
				<tws-auto type="bool">false</tws-auto>
			</mode>
		</radar>
		
		<radar2>
			<sweep-width-m type="double">0.0844</sweep-width-m>
			<range-width-m type="double">0.0846</range-width-m>
			<radius-ppi-display-m type="double">0.0846</radius-ppi-display-m>
			<hud-eye-dist-m type="double">0.766</hud-eye-dist-m>
			<hud-radius-m type="double">0.071</hud-radius-m>
			<hud-vertical-offset-m type="double">-0.025</hud-vertical-offset-m>
		</radar2>
		
		<rwr>
			<display-lighting-intens type="double">0.4</display-lighting-intens>
			<symbology-lighting-intens type="double">1</symbology-lighting-intens>
		</rwr>
 
  <rdmi-mode type="int">0</rdmi-mode> <!-- 0=TAC, 1=VOR, 2=ADF -->
 </instrumentation>

 <nasal>
 
    <F-4EJ_ADTW>

      <file>Aircraft/FGR-2/Nasal/instruments.nas</file>

    </F-4EJ_ADTW>


	
	<lights>
      <file>Aircraft/FGR-2/Nasal/Lights.nas</file>
    </lights>

 <rwr>
			<file>Aircraft/Instruments-3d/rwr/rwr.nas</file>
		</rwr>
		
		<radardist>
			<file>Aircraft/Instruments-3d/radardist/radardist.nas</file>
		</radardist>
		
		<radar>
			<file>Aircraft/FGR-2/Nasal/radar.nas</file>
		</radar>
		
		<radar2>
			<file>Aircraft/Instruments-3d/radar2/radar2.nas</file>
		</radar2>
	
	
  <dual_control_tools>
   <file>Aircraft/Generic/DualControl/dual-control-tools.nas</file>
  </dual_control_tools>
  <aircraft_dual_control>
   <file>Aircraft/FGR-2/Nasal/f4-dual-control.nas</file>
  </aircraft_dual_control>
  <dual_control>
   <file>Aircraft/Generic/DualControl/copilot-dual-control.nas</file>
  </dual_control>
  
 </nasal>

</PropertyList>

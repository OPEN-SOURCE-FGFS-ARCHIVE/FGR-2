<?xml version="1.0"?>
<PropertyList>

 <path>Radar2.ac</path>
 
 <model>
    <path>Aircraft/Instruments-3d/radar2/radar-screen.xml</path>
    <offsets>
      <x-m>0.05 </x-m>
      <y-m>-0.005 </y-m>
      <z-m>0</z-m>
      <roll-deg> 0 </roll-deg>
      <pitch-deg>0</pitch-deg>

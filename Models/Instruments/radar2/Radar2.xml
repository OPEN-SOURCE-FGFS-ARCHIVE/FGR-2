	 <overlay>
		 <animation n="900">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>1.05</y-offset>
    <z-offset>1.05</z-offset>
   </animation>
  </overlay>
  </model>
  
  

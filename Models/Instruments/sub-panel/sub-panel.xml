<?xml version="1.0"?>

<PropertyList>

    <path>sub-panel.ac</path>


  <animation>
   <type>material</type>
    <object-name>sub-panel-LH</object-name>
    <object-name>sub-panel-RH</object-name>
    <object-name>ext-LT</object-name>
    <object-name>boost-pump-ndl1</object-name>
    <object-name>boost-pump-ndl2</object-name>
    <object-name>boost-pump</object-name>
    <object-name>level</object-name>
    <object-name>stb-trim-ndl</object-name>
     <emission>
      <factor-prop>systems/electrical/outputs/instrument-lights-norm</factor-prop>
        <red>0.5</red>
        <green>0.2</green>
        <blue>0.2</blue>
      </emission>
  </animation>

  <animation>
	  <type>material</type>
	  <object-name>gear-down</object-name>
	  <object-name>gear-up</object-name>
          <object-name>flaps-te</object-name>
          <object-name>flaps-le</object-name>
	  <emission>
		  <red>   0.8 </red>
		  <green> 0.7 </green>
		  <blue>  0.5 </blue>
		  <factor-prop>systems/electrical/outputs/instrument-lights-norm</factor-prop>
	  </emission>
  </animation>

  <animation>
        <type>select</type>
        <object-name>gear-down</object-name>
        <condition>
            <property>gear/gear[2]/position-norm</property>
        </condition>
    </animation>


  <animation>
        <type>select</type>
        <object-name>flaps-te</object-name>
        <condition>
            <greater-than>
            <property>/surface-positions/flap-pos-norm</property>
            <value>0.49</value>
            </greater-than>
        </condition>
    </animation>

  <animation>
        <type>select</type>
        <object-name>flaps-le</object-name>
        <condition>
            <property>/surface-positions/flap-pos-norm</property>
        </condition>
    </animation>


<!-- LDG LIGHT -->

    <animation>
        <type>pick</type>
        <object-name>ldg-on</object-name>
        <visible>false</visible>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-assign</command>
        <property>controls/switches/taxi-lights</property>
        <value>false</value>
      </binding>
      <binding>
        <command>property-assign</command>
        <property>controls/switches/landing-light</property>
        <value>true</value>
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>sim/sound/click</property>
      </binding>
    </action>
    </animation>

  <animation>
    <type>rotate</type>
     <object-name>ext-LT</object-name>
    <property>controls/switches/landing-light</property>
    <factor> 35 </factor>
    <axis>
      <x1-m> 0.009 </x1-m>
      <y1-m> -0.421 </y1-m>
      <z1-m> -0.059 </z1-m>
      <x2-m> 0.001 </x2-m>
      <y2-m> -0.409 </y2-m>
      <z2-m> -0.060 </z2-m>
    </axis>
  </animation>


<!-- TAXI LIGHT -->

    <animation>
        <type>pick</type>
        <object-name>taxi-on</object-name>
        <visible>false</visible>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-assign</command>
        <property>controls/switches/taxi-lights</property>
        <value>true</value>
      </binding>
      <binding>
        <command>property-assign</command>
        <property>controls/switches/landing-light</property>
        <value>false</value>
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>sim/sound/click</property>
      </binding>
    </action>
    </animation>

  <animation>
    <type>rotate</type>
     <object-name>ext-LT</object-name>
    <property>controls/switches/taxi-lights</property>
    <factor> -35 </factor>
    <axis>
      <x1-m> 0.009 </x1-m>
      <y1-m> -0.421 </y1-m>
      <z1-m> -0.059 </z1-m>
      <x2-m> 0.001 </x2-m>
      <y2-m> -0.409 </y2-m>
      <z2-m> -0.060 </z2-m>
    </axis>
  </animation>

<!-- LIGHT OFF -->

    <animation>
        <type>pick</type>
        <object-name>off</object-name>
        <visible>false</visible>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-assign</command>
        <property>controls/switches/taxi-lights</property>
        <value>false</value>
      </binding>
      <binding>
        <command>property-assign</command>
        <property>controls/switches/landing-light</property>
        <value>false</value>
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>sim/sound/click</property>
      </binding>
    </action>
    </animation>

<!-- BOOST PUMP -->

 <animation> 
  <type>rotate</type>
  <object-name>boost-pump-ndl1</object-name>
  <property>engines/engine[1]/oilp-norm</property>
  <interpolation>
   <entry><ind>0</ind><dep>0</dep></entry>
   <entry><ind>0.1</ind><dep>160</dep></entry>
   <entry><ind>0.5</ind><dep>180</dep></entry>
  </interpolation>
    <axis>
      <x1-m> -0.005 </x1-m>
      <y1-m> -0.394 </y1-m>
      <z1-m> -0.004 </z1-m>
      <x2-m> -0.007 </x2-m>
      <y2-m> -0.395 </y2-m>
      <z2-m> -0.004 </z2-m>
    </axis>
 </animation> 

 <animation> 
  <type>rotate</type>
  <object-name>boost-pump-ndl2</object-name>
  <property>engines/engine[0]/oilp-norm</property>
  <interpolation>
   <entry><ind>0</ind><dep>0</dep></entry>
   <entry><ind>0.1</ind><dep>160</dep></entry>
   <entry><ind>0.5</ind><dep>180</dep></entry>
  </interpolation>
    <axis>
      <x1-m> -0.031 </x1-m>
      <y1-m> -0.353 </y1-m>
      <z1-m> -0.004 </z1-m>
      <x2-m> -0.033 </x2-m>
      <y2-m> -0.354 </y2-m>
      <z2-m> -0.004 </z2-m>
    </axis>
 </animation>  

<!-- STAB TRIM -->

 <animation> 
  <type>rotate</type>
  <object-name>stb-trim-ndl</object-name>
  <property>controls/flight/elevator-trim</property>
  <interpolation>
   <entry><ind>-0.1</ind><dep>42</dep></entry>
   <entry><ind>0</ind><dep>0</dep></entry>
   <entry><ind>0.1</ind><dep>-42</dep></entry>
  </interpolation>V
    <axis>
      <x1-m>  0.028 </x1-m>
      <y1-m> -0.447 </y1-m>
      <z1-m> -0.034 </z1-m>
      <x2-m>  0.026 </x2-m>
      <y2-m> -0.448 </y2-m>
      <z2-m> -0.034 </z2-m>
    </axis>
 </animation> 








    <animation>
       <type>range</type>
       <min-m>0</min-m>
       <max-m>100</max-m>
    </animation>

</PropertyList>



<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>nav-selector.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>base</object-name>
    <object-name>texte</object-name>
    <object-name>Switch0</object-name>
    <object-name>Switch1</object-name>
    <object-name>Switch2</object-name>
    <object-name>Switch3</object-name>
    <object-name>Switch4</object-name>
    <object-name>Switch5</object-name>
    <object-name>cache</object-name>
    <object-name>switch</object-name>
    <!-- Objets transparents -->
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>base</object-name>
    <object-name>texte</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>texte</object-name>
    <object-name>Switch0</object-name>
    <object-name>Switch1</object-name>
    <object-name>Switch2</object-name>
    <object-name>Switch3</object-name>
    <object-name>Switch4</object-name>
    <object-name>Switch5</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

</PropertyList>
